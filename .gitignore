# Gradle
.gradle/
build/
app/build/
!gradle/wrapper/gradle-wrapper.jar

# Kotlin daemon / language server state
.kotlin/

# Android Studio / IntelliJ
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# Local configuration (contains machine-specific paths; never commit secrets)
local.properties

# Firmware (PlatformIO)
firmware/.pio/
# Local Wi-Fi credentials for the ESP32 display — build-time only, never commit
firmware/include/wifi_config.h

# Signing
*.jks
*.keystore

# Legacy Mappls SDK auth files (pre-Google migration) — generated locally, dead weight,
# and must never be swept into a commit by `git add -A`
*.a.conf
*.a.olf
app/src/debug/assets/mappls-conf.txt

# Packaged artifacts (build outputs are never committed)
*.apk
*.aab
*.ap_
*.dex

# Crash / profiling
*.hprof

# OS
.DS_Store
