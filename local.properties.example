# Copy to local.properties (already used by Gradle for sdk.dir) and adjust.
# NEVER commit real secrets; this file is a template only.

# REQUIRED — Mappls Console access token (docs/mappls.md). One token enables traffic-aware
# two-wheeler routing (Direction API v1, resource route_traffic) AND Mappls place search +
# reverse geocoding. Get it from the Mappls Console (Credentials → REST APIs) for the same
# application whose .a.olf / .a.conf SDK auth files live in app/.
# Without it, route calculation fails with a clear configuration error (no OSRM fallback).
mappls.accessToken=

# Optional overrides (defaults shown). Route profile: biking (two-wheeler) | driving | trucking.
# mappls.routing.baseUrl=https://route.mappls.com/
# mappls.search.baseUrl=https://search.mappls.com/
# mappls.routing.profile=biking

# Destination search when NO Mappls token is configured (public Nominatim, low-volume use).
geocoder.baseUrl=https://nominatim.openstreetmap.org/

# Default camera (Hyderabad)
default.latitude=17.3850
default.longitude=78.4867
default.zoom=12.5

# Developer demo switch compiled into the app (default false — flip to true while developing
# the simulator; leave unset/false for normal builds)
demo.enabled=false

# Optional Google Maps key for the display pipeline's Google Navigation SDK path
# (see docs/display-pipeline.md). Empty = the display uses HunterNav's own engine.
google.maps.apiKey=

# Handlebar display pipeline: WebSocket endpoint of the ESP32 display
# (192.168.4.1 is the ESP32 soft-AP default) and a dev switch that forces the offline
# simulator as the display navigation source regardless of API key.
display.wsUrl=ws://192.168.4.1:81/display
display.simulator=false
