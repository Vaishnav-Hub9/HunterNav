# Copy to local.properties (already used by Gradle for sdk.dir) and adjust.
# NEVER commit real secrets; this file is a template only.

# REQUIRED — Google Maps Platform API key (docs/google-maps.md). ONE key covers:
#   - Maps SDK for Android (the phone map, via manifest meta-data),
#   - Routes API v2 (traffic-aware TWO_WHEELER routing),
#   - Geocoding API (destination search + reverse geocoding),
#   - Map Tiles API (raster tiles for the handlebar display).
# Enable all four APIs on your Google Cloud project and restrict the key to this app
# (Android package com.hunternav + your signing certificate's SHA-1).
# Without it, routing and search fail with a clear configuration error (no fallback engine)
# and the map renders no tiles.
google.maps.apiKey=

# Optional endpoint overrides (defaults shown).
# google.routes.baseUrl=https://routes.googleapis.com
# google.geocoding.baseUrl=https://maps.googleapis.com

# Default camera (Hyderabad)
default.latitude=17.3850
default.longitude=78.4867
default.zoom=12.5

# Developer demo switch compiled into the app (default false — flip to true while developing
# the simulator; leave unset/false for normal builds)
demo.enabled=false

# Handlebar display pipeline (see docs/display-pipeline.md): WebSocket endpoint of the ESP32
# display (192.168.4.1 is the ESP32 soft-AP default), a dev switch that forces the offline
# simulator as the display navigation source, and the panel resolution.
display.wsUrl=ws://192.168.4.1:81/display
display.simulator=false
display.width=240
display.height=240
